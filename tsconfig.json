{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16", //si no funciona cambia por commonjs
    "esModuleInterop": true,
    "strict": true,
    "moduleResolution": "node16",
    "outDir": "dist",
    "rootDir": "src",
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
